{
    "name": "indianopinion/echo-robots-guard",
    "description": "WordPress plugin that checks robots.txt (RFC 9309) before the Echo RSS importer downloads an article page.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "robots.txt", "rfc9309", "crawler", "echo", "rss"],
    "homepage": "https://github.com/IndianOpinion/echo-robots-guard",
    "support": {
        "issues": "https://github.com/IndianOpinion/echo-robots-guard/issues",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        { "name": "Indian Opinion", "email": "hello@indianopinion.org" }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": { "IndianOpinion\\EchoRobotsGuard\\": "src/" },
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": { "IndianOpinion\\EchoRobotsGuard\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "platform": { "php": "8.1.0" },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable"
}
